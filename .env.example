# Copia este archivo como .env y completa los valores.
# En local basta con DJANGO_SECRET_KEY, DEBUG y GROQ_API_KEY; lo demás es opcional.

# ── Obligatorias ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-50-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── IA (clave gratis en console.groq.com) ─────────────────────────────────────
GROQ_API_KEY=gsk_TuClaveDeGroqAqui
GROQ_MODEL=openai/gpt-oss-120b
# Respaldo local con Ollama (se usa si Groq no está disponible)
# OLLAMA_URL=http://localhost:11434/api/generate

# ── Base de datos ─────────────────────────────────────────────────────────────
# Sin DATABASE_URL se usa SQLite (db.sqlite3). Railway la inyecta en producción.
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/nombre_bd

# ── Correo con Brevo (códigos OTP y recuperación de contraseña) ───────────────
# Sin BREVO_API_KEY, en local (DEBUG=True) el código OTP y el correo de
# recuperación se muestran en la terminal donde corre el servidor.
# BREVO_API_KEY=xkeysib-TuClaveApiDeBrevo
# BREVO_SENDER_EMAIL=medusaingesis@gmail.com

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
# URI de redirección a registrar en Google Cloud:
#   https://<tu-dominio>/accounts/google/login/callback/
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ── n8n (opcional) ────────────────────────────────────────────────────────────
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/medusa
# N8N_TOKEN=clave-secreta-compartida-con-n8n   (sin ella, /api/clasificar/ y /api/agente/ quedan cerrados)

# ── Producción ────────────────────────────────────────────────────────────────
# DEBUG=False
# ALLOWED_HOSTS=tudominio.up.railway.app
