# Copia este archivo como ".env" (sin .example) y ajusta los valores.
# El .env NUNCA se sube a Git (agregalo a .gitignore si no esta).

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Correo para el codigo OTP ---
# Para que tus companeros SOLO revisen el proyecto, lo mas simple es
# dejar el backend en "console": el codigo OTP no se envia por correo
# de verdad, se imprime en la terminal donde corre "docker compose up".
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Modelo de lenguaje (Groq) ---
# Crea tu cuenta gratuita en https://console.groq.com y copia tu API key.
# Sin esta variable, el sistema usara Ollama local como fallback.
GROQ_API_KEY=
# Modelo a usar (por defecto llama-3.1-8b-instant, muy rapido y gratuito)
# Otras opciones: mixtral-8x7b-32768, llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# --- Login con Google (opcional) ---
# Si no configuras esto, el boton "Iniciar sesion con Google" no
# funcionara, pero el login normal (correo + contrasena + OTP) si.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=